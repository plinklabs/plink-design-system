<Application
    x:Class="PlinkDesignSystem.Sample.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- The default WinUI controls resources, then the whole Plink
                     Labs binding in a single merge. -->
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///PlinkDesignSystem/PlinkResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- DS-5: this app layers its own identity on the foundations by
                 overriding the one per-product accent slot. Keys defined here,
                 after the merge, win over the binding's neutral default. The
                 magenta spark is untouched. -->
            <Color x:Key="PlinkProductAccentColor">#FF2563EB</Color>
            <SolidColorBrush x:Key="PlinkProductAccentBrush" Color="{StaticResource PlinkProductAccentColor}" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
