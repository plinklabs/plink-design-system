<Window
    x:Class="PlinkDesignSystem.Sample.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pds="using:PlinkDesignSystem.Controls"
    Title="Plink Labs — WinUI binding">

    <Grid Background="{StaticResource PlinkPaperBrush}">
        <ScrollViewer>
            <StackPanel MaxWidth="760" HorizontalAlignment="Center" Spacing="24" Padding="40">

                <!-- ── the full-bleed ink section (the agent's primary surface) ── -->
                <Border Style="{StaticResource PlinkInkSectionStyle}" CornerRadius="8">
                    <StackPanel Spacing="20">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Ellipse Width="9" Height="9" Fill="{StaticResource PlinkMagentaOnDarkBrush}"
                                     VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource PlinkEyebrowTextStyle}"
                                       Foreground="{StaticResource PlinkOnInkBrush}"
                                       Text="OPEN SOURCE — FREE FOR EVERY CLASSROOM" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource PlinkDisplayMediumTextStyle}"
                                   Foreground="{StaticResource PlinkOnInkBrush}">
                            <Run Text="Built for the " /><Run Text="classroom"
                                Foreground="{StaticResource PlinkMagentaOnDarkBrush}" /><Run Text="." />
                        </TextBlock>

                        <TextBlock Style="{StaticResource PlinkBodyLargeTextStyle}"
                                   Foreground="{StaticResource PlinkOnInkBrush}"
                                   Text="Anchor turns any classroom projector into a calm, offline-first instrument. No accounts, no ads, no CDN." />

                        <StackPanel Orientation="Horizontal" Spacing="40" VerticalAlignment="Center">
                            <pds:Ping Diameter="44" OnInk="True" />
                            <pds:Ping Diameter="28" Mode="Static" OnInk="True" />
                            <Button Style="{StaticResource PlinkPrimaryButtonStyle}" Content="START" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ── type ramp on paper ──────────────────────────────────── -->
                <TextBlock Style="{StaticResource PlinkLabelStrongTextStyle}" Text="TYPE" />
                <TextBlock Style="{StaticResource PlinkDisplaySmallTextStyle}" Text="Built for the classroom" />
                <TextBlock Style="{StaticResource PlinkTitleLargeTextStyle}" Text="Title — Hanken Grotesk SemiBold" />
                <TextBlock Style="{StaticResource PlinkBodyTextStyle}"
                           Text="Body — Hanken Grotesk. 16px is the floor for projector legibility; magenta stays a spark." />
                <TextBlock Style="{StaticResource PlinkCaptionTextStyle}" Text="GPL-3.0 · WORKS OFFLINE · 16PX → PROJECTOR" />

                <!-- ── buttons ─────────────────────────────────────────────── -->
                <TextBlock Style="{StaticResource PlinkLabelStrongTextStyle}" Text="BUTTONS" />
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <Button Style="{StaticResource PlinkPrimaryButtonStyle}" Content="START" />
                    <Button Content="LEARN MORE" />
                    <Button Content="DISABLED" IsEnabled="False" />
                </StackPanel>

                <!-- ── input ───────────────────────────────────────────────── -->
                <TextBlock Style="{StaticResource PlinkLabelStrongTextStyle}" Text="INPUT" />
                <TextBox Header="Room name" PlaceholderText="e.g. 4B — Mr. Okafor" />

                <!-- ── card ────────────────────────────────────────────────── -->
                <TextBlock Style="{StaticResource PlinkLabelStrongTextStyle}" Text="CARD" />
                <Border Style="{StaticResource PlinkCardStyle}">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <pds:Ping Diameter="14" Mode="Static" />
                            <TextBlock Style="{StaticResource PlinkTitleMediumTextStyle}" Text="Timer" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource PlinkBodyTextStyle}"
                                   Text="A big, calm countdown. One hairline border, six-pixel radius, no shadow — surfaces sit on the paper, they don't float." />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
