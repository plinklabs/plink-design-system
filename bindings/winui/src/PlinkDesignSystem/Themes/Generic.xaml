<!--  Default control templates for the Plink Labs custom controls. WinUI
      auto-discovers this file (Themes/Generic.xaml) for templated controls in
      the library. Ping colours and the pulse storyboard are applied in code
      (Ping.cs), so this template stays colour-agnostic and never depends on
      the app having merged the design-system dictionary.  -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PlinkDesignSystem.Controls">

    <Style TargetType="controls:Ping">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:Ping">
                    <Grid x:Name="PART_Root">
                        <Ellipse x:Name="PART_Ring1"
                                 Stretch="Fill"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform x:Name="PART_Ring1Scale" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse x:Name="PART_Ring2"
                                 Stretch="Fill"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform x:Name="PART_Ring2Scale" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse x:Name="PART_Core"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
