<!--  Plink Labs — control styles. The house rules, enforced: ONE radius
      language (crisp 6px), 1px hairline borders, NO drop shadows anywhere,
      magenta reserved as the focus / spark.

      Strategy: the design system is opinionated, so it overrides the WinUI
      lightweight-styling theme resources for the default Button / TextBox
      (every unstyled control comes out on-brand and neutral), then adds keyed
      styles for the rare spark primary button and the card surfaces.  -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── one radius language: crisp 6px everywhere ────────────────── -->
    <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">6</CornerRadius>

    <!-- ── default Button = neutral instrument button ───────────────────
         Transparent fill + hairline border; hover/press darken the BORDER to
         full ink (never a shadow, never a colour flip).  -->
    <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{StaticResource PlinkPaper2Color}" />
    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{StaticResource PlinkPaper3Color}" />
    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
    <SolidColorBrush x:Key="ButtonForeground" Color="{StaticResource PlinkInkColor}" />
    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{StaticResource PlinkInkColor}" />
    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{StaticResource PlinkInkColor}" />
    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="{StaticResource PlinkMutedColor}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{StaticResource PlinkHairlineStrongColor}" />
    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{StaticResource PlinkInkColor}" />
    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{StaticResource PlinkInkColor}" />
    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="{StaticResource PlinkHairlineColor}" />

    <!-- ── default TextBox = paper field, magenta focus ─────────────────
         Uniform 1px hairline (no heavy bottom underline); the border goes
         magenta on focus — the spark, as a focus ring.  -->
    <SolidColorBrush x:Key="TextControlBackground" Color="{StaticResource PlinkPaperColor}" />
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{StaticResource PlinkPaperColor}" />
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{StaticResource PlinkPaperColor}" />
    <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="{StaticResource PlinkPaper2Color}" />
    <SolidColorBrush x:Key="TextControlBorderBrush" Color="{StaticResource PlinkHairlineStrongColor}" />
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="{StaticResource PlinkInkColor}" />
    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{StaticResource PlinkMagentaColor}" />
    <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="{StaticResource PlinkHairlineColor}" />
    <SolidColorBrush x:Key="TextControlForeground" Color="{StaticResource PlinkInkColor}" />
    <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="{StaticResource PlinkInkColor}" />
    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="{StaticResource PlinkInkColor}" />
    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{StaticResource PlinkMutedColor}" />
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="{StaticResource PlinkMutedColor}" />
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="{StaticResource PlinkMutedColor}" />
    <Thickness x:Key="TextControlBorderThemeThickness">1</Thickness>
    <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>

    <!-- ── secondary (neutral) button — also the implicit default ─────── -->
    <Style x:Key="PlinkSecondaryButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource PlinkMonoFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CharacterSpacing" Value="40" />
        <Setter Property="Padding" Value="24,12" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource PlinkSecondaryButtonStyle}" />

    <!-- ── primary (spark) button — magenta, the single primary action ──
         Retemplated so it is self-contained (the magenta hover/press + the
         tiny physical press nudge + the 2px magenta focus ring) and immune to
         the neutral Button* overrides above.  -->
    <Style x:Key="PlinkPrimaryButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource PlinkMonoFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CharacterSpacing" Value="40" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{StaticResource PlinkMagentaBrush}" />
        <Setter Property="Padding" Value="24,12" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter x:Name="ContentPresenter"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    Padding="{TemplateBinding Padding}"
                                    Foreground="{TemplateBinding Foreground}"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    RenderTransformOrigin="0.5,0.5">
                                <ContentPresenter.RenderTransform>
                                    <ScaleTransform x:Name="ContentScale" />
                                </ContentPresenter.RenderTransform>
                            </ContentPresenter>
                        </Border>
                        <!-- 2px magenta focus ring, 3px offset -->
                        <Border x:Name="FocusRing"
                                CornerRadius="8"
                                BorderBrush="{StaticResource PlinkFocusRingBrush}"
                                BorderThickness="2"
                                Margin="-3"
                                Opacity="0"
                                IsHitTestVisible="False" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Bg" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource PlinkMagentaPressBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Bg" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource PlinkMagentaPressBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="ContentScale" Storyboard.TargetProperty="ScaleX" To="0.985" Duration="0" />
                                        <DoubleAnimation Storyboard.TargetName="ContentScale" Storyboard.TargetProperty="ScaleY" To="0.985" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Bg" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Focused">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Unfocused" />
                                <VisualState x:Name="PointerFocused" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── default TextBox typography + padding ─────────────────────── -->
    <Style x:Key="PlinkInputStyle" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource PlinkBodyFontFamily}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource PlinkInputStyle}" />

    <!-- ── cards & the full-bleed ink section — hairlines, never shadows ─
         There is no Card primitive in WinUI; a bordered Border is the
         idiomatic equivalent. Flat fill + 1px hairline + 6px radius.  -->
    <Style x:Key="PlinkCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PlinkPaperBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PlinkHairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="24" />
    </Style>
    <Style x:Key="PlinkInkCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PlinkSurfaceInkBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PlinkHairlineOnInkBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="24" />
    </Style>
    <!-- The one full-bleed ink section per page (the agent's primary surface):
         solid ink, no border, generous padding. -->
    <Style x:Key="PlinkInkSectionStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PlinkSurfaceInkBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="40,32" />
    </Style>

</ResourceDictionary>
